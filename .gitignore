# ============================================================
# Python
# ============================================================

# Byte-compiled Python files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python packaging and build output
.Python
build/
dist/
develop-eggs/
eggs/
.eggs/
wheels/
pip-wheel-metadata/
*.egg-info/
*.egg
.installed.cfg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# ============================================================
# Python testing, coverage, linting, and type checking
# ============================================================

.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/
.hypothesis/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# Other Python type checkers
.pyre/
.pytype/

# ============================================================
# TypeScript, JavaScript, Node.js, pnpm, and Vite
# ============================================================

# Installed Node dependencies
node_modules/

# Local pnpm store, if configured inside the project
.pnpm-store/

# Vite cache and production output
.vite/
dist/

# TypeScript incremental build information
*.tsbuildinfo

# ESLint cache
.eslintcache

# JavaScript test coverage
coverage/

# Package-manager and Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary Vite configuration files
vite.config.*.timestamp-*

# ============================================================
# Environment variables and secrets
# ============================================================

.env
.env.*
*.local

# Allow safe example environment files
!.env.example
!.env.*.example

# ============================================================
# Documentation and notebooks
# ============================================================

# Sphinx build output
docs/_build/
**/docs/_build/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# ============================================================
# Editors and IDEs
# ============================================================

# VS Code project-specific settings
.vscode/

# JetBrains IDEs
.idea/

# ============================================================
# Operating-system files
# ============================================================

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# ============================================================
# Temporary files
# ============================================================

*.tmp
*.temp
*~
